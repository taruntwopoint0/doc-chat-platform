# Copy to .env and fill in. No value here is baked into the code -- every model
# name, limit and provider choice is read from this file at startup.

# --- Required --------------------------------------------------------------

# postgresql:// is rewritten to the asyncpg driver automatically, so Render's
# connection string can be pasted in unchanged.
DATABASE_URL=postgresql://docchat:docchat@localhost:5432/docchat

# Shared secret for every endpoint except /health. Generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me

# Sign-in. Off by default: the dashboard opens straight onto the workspace.
# Turn it ON for anything reachable by someone else -- an open instance lets
# anyone upload to your corpus and spend your Gemini quota.
AUTH_ENABLED=false

# Used only when AUTH_ENABLED=true. The first account, created once on an empty users table so a fresh
# deployment can be signed into. Ignored after that -- change the password
# in the app, not here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying
# Session cookie lifetime, and whether it requires HTTPS. Render is always
# HTTPS, so set COOKIE_SECURE=true there; false for plain-http local dev
# or the browser drops the cookie and you can never sign in.
SESSION_TTL_HOURS=720
COOKIE_SECURE=false

GEMINI_API_KEY=

# Model names are configuration, not code. Check the current identifiers
# against Google's model list before deploying -- these are what the brief
# specified, not a guarantee that they exist in your project.
EMBEDDING_MODEL=gemini-embedding-2
LLM_MODEL=gemini-3.1-flash-lite

# --- Implementation selection ---------------------------------------------

# lite    = per-format libraries, no ML dependencies (default)
# docling = layout models and OCR for scanned PDFs; needs the `docling` extra
#           (pip install -e ".[docling]") and roughly 2 GB more disk
PARSER=lite

EMBEDDER_IMPL=gemini
LLM_IMPL=gemini
VECTOR_STORE_IMPL=pgvector
FILE_STORE_IMPL=postgres

# --- Ingestion tuning ------------------------------------------------------

# The whole upload is held in memory to hash and store it, so this is really
# a statement about the instance's RAM. 50 suits a normal machine; Render's
# free tier has 512 MB total, so render.yaml pins it to 10 there.
MAX_UPLOAD_MB=50
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_RATIO=0.15

# Must match the vector(N) width of chunks.embedding. Changing it needs a
# migration; app startup refuses to run if the two disagree.
EMBEDDING_DIMENSIONS=768

# Hard ceiling on a chunk, from the embedding model's input limit.
EMBED_MAX_INPUT_TOKENS=8192
EMBED_BATCH_SIZE=32
EMBED_MAX_RETRIES=5

# Characters of each section shown to the profiling LLM.
PROFILE_SECTION_CHARS=2000

# section = one LLM call describes every section of a document (cheap, default)
# chunk   = one call per chunk: sharper headers, one request per chunk
CONTEXT_DESCRIPTIONS=section

# --- Worker ----------------------------------------------------------------

WORKER_ENABLED=true
# 0.1 CPU on the free tier -- more than one loop just fights itself.
WORKER_CONCURRENCY=1
WORKER_POLL_SECONDS=2
# A running job with no heartbeat for this long is treated as abandoned and
# returned to the queue.
WORKER_JOB_TIMEOUT_SECONDS=3600
JOB_MAX_ATTEMPTS=3

# --- Parsing ---------------------------------------------------------------

# Needed only for legacy .doc/.ppt/.xls. Not installed in the Docker image;
# see the note in the Dockerfile.
SOFFICE_BINARY=soffice
SOFFICE_TIMEOUT_SECONDS=180

# Only used by PARSER=docling.
OCR_ENABLED=true

# Postgres text-search configuration for the generated tsv column. Changing it
# requires a migration, since tsv is a generated column.
FTS_LANGUAGE=english

LOG_LEVEL=INFO
